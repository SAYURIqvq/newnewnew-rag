# DeepSeek LLM (Anthropic-compatible API) — REQUIRED for chat / agents
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=your_deepseek_api_key_here
ANTHROPIC_MODEL=deepseek-chat
# Optional model aliases (used by some Claude Code tooling; safe to set)
# ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-chat
# ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-chat
# ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-chat

# Embeddings: local BGE by default (no API key). For Voyage, set:
# VOYAGE_API_KEY=your_voyage_key_here
# EMBEDDING_MODEL=voyage-3
# COHERE_API_KEY=your_cohere_key_here

# Database Configuration
DATABASE_URL=postgresql://localhost:5432/agentic_rag
REDIS_URL=redis://localhost:6379
CHROMA_PERSIST_DIR=./data/chroma

# Model Configuration
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50
PARENT_CHUNK_SIZE=2000

# Retrieval Configuration
RETRIEVAL_TOP_K=10
VECTOR_SEARCH_WEIGHT=0.7
KEYWORD_SEARCH_WEIGHT=0.3

# Agent Configuration
PLANNER_COMPLEXITY_THRESHOLD_SIMPLE=0.3
PLANNER_COMPLEXITY_THRESHOLD_MULTIHOP=0.7
VALIDATOR_THRESHOLD=0.7
VALIDATOR_MAX_RETRIES=2
CRITIC_MAX_ITERATIONS=3

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600

# System Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt

# Performance Configuration
BATCH_SIZE=128
PARALLEL_RETRIEVAL=true
REQUEST_TIMEOUT=30
